rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function admin() {
      return autenticado()
        && (
          request.auth.token.email == 'pedrorouge2022@gmail.com'
          || (exists(/databases/$(database)/documents/usuarios_roles/$(request.auth.uid))
              && get(/databases/$(database)/documents/usuarios_roles/$(request.auth.uid)).data.rol == 'admin')
        );
    }

    match /usuarios_roles/{userId} {
      allow read: if autenticado() && (request.auth.uid == userId || admin());
      allow write: if admin() || (autenticado() && request.auth.uid == userId && request.auth.token.email == 'pedrorouge2022@gmail.com');
    }

    match /telas/{telaId} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /avios/{avioId} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /clientes/{clienteId} {
      allow read: if autenticado();

      allow create: if autenticado();

      allow update: if admin()
        || (
          autenticado() && (
            resource.data.id == request.auth.uid 
            || clienteId == request.auth.uid
            || resource.data.authUid == request.auth.uid
            || resource.data.email == request.auth.token.email
          )
        );

      allow delete: if admin();
    }

    match /pedidos/{pedidoId} {
      allow read: if admin()
        || (
          autenticado() && (
            resource.data.clienteId == request.auth.uid
            || resource.data.authUid == request.auth.uid
          )
        );

      allow create: if admin()
        || (
          autenticado() 
          && (request.resource.data.clienteId == request.auth.uid || request.resource.data.authUid == request.auth.uid)
          && request.resource.data.estado == 'Pendiente de Aprobación'
          && request.resource.data.precio == 0
          && request.resource.data.pagado == false
        );

      allow update: if admin()
        || (
          autenticado()
          && (resource.data.clienteId == request.auth.uid || resource.data.authUid == request.auth.uid)
          && request.resource.data.precio == resource.data.precio
          && request.resource.data.pagado == resource.data.pagado
        );

      allow delete: if admin()
        || (
          autenticado()
          && (resource.data.clienteId == request.auth.uid || resource.data.authUid == request.auth.uid)
        );
    }
  }
}

